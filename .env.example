# ── Payload ──────────────────────────────────────────────────────────────────
# Random 32+ char string — run: openssl rand -hex 32
PAYLOAD_SECRET=

# Public URL of the app (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Neon Postgres ────────────────────────────────────────────────────────────
# Neon dashboard → Project → Connect → Connection string (pooled recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ── Cloudflare R2 (S3-compatible) ───────────────────────────────────────────
# R2 → Manage R2 API Tokens → Create token with Object Read & Write
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=textures-atlas
# Account ID from Cloudflare dashboard URL or R2 overview
R2_ACCOUNT_ID=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Public base URL for media (R2 custom domain or r2.dev public bucket URL).
# REQUIRED whenever R2 storage is on — without it the app falls back to local
# storage, because R2_ENDPOINT is the SigV4-authenticated S3 API host and 403s
# for anonymous browser requests.
#
# The bucket must also send CORS headers for this site's origin: map pins draw
# thumbnails into a <canvas> and call getImageData(), which throws SecurityError
# on a tainted canvas, so without CORS every pin falls back to a flat square.
# R2 → your bucket → Settings → CORS policy:
#   [
#     {
#       "AllowedOrigins": ["https://your-site.example", "http://localhost:3000"],
#       "AllowedMethods": ["GET", "HEAD"],
#       "AllowedHeaders": ["*"],
#       "ExposeHeaders": ["Content-Length", "Content-Type"],
#       "MaxAgeSeconds": 3600
#     }
#   ]
R2_PUBLIC_URL=https://pub-XXXX.r2.dev
# Set to false to use local ./media storage instead of R2 (dev / misconfigured keys)
R2_STORAGE_ENABLED=true
