    "@payloadcms/storage-s3": "3.86.0",
    "@phosphor-icons/react": "^2.1.10",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.14.2",
    "maplibre-gl": "^5.6.0",
    "next": "16.2.12",
    "payload": "3.86.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
