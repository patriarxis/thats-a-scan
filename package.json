  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:importmap": "node --experimental-strip-types ./node_modules/payload/bin.js --disable-transpile generate:importmap",
    "generate:types": "node --experimental-strip-types ./node_modules/payload/bin.js --disable-transpile generate:types",
    "payload": "node --experimental-strip-types ./node_modules/payload/bin.js --disable-transpile",
    "payload:check": "node --experimental-strip-types --env-file=.env.local scripts/check-payload.ts",
    "migrate:geojson": "node --experimental-strip-types --env-file=.env.local scripts/migrate-geojson-to-payload.ts",
    "migrate:tags": "node --experimental-strip-types --env-file=.env.local scripts/migrate-tags-to-taxonomy.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
