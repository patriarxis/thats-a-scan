    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.2.12",
    "sass": "^1.93.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "dompurify": "^3.4.12",
    "esbuild": "^0.25.0",
    "fast-uri": "^3.1.4",
    "immutable": "^5.1.8",
